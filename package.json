{
  "name": "@coldpress/core",
  "version": "0.4.0-alpha",
  "description": "AI-native development framework: 11-phase lifecycle (Shape A) + lite lane, 8 subagents, plugin-distributed skills, sacred-doc governance, enforcement hooks, forward-carry quartet.",
  "type": "module",
  "bin": {
    "coldpress": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "lifecycle",
    "skills",
    "governance",
    "data",
    "authoring",
    "schemas",
    "docs",
    "!docs/overhaul",
    "plugin",
    "evals",
    "coldpress.yaml",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "build:skills": "tsx src/generators/build-skills.ts",
    "build:roster": "tsx src/generators/build-agent-roster.ts",
    "build:deploy-matrix": "tsx src/generators/build-deploy-matrix.ts",
    "build:client-touchpoints": "tsx src/generators/build-client-touchpoints.ts",
    "lint:frontmatter": "tsx src/generators/frontmatter-lint.ts",
    "check:drift": "tsx src/generators/check-drift.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke:pack": "bash scripts/ci/pack-smoke.sh",
    "evals": "node dist/cli.js evals --dir evals",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "lint:staleness": "tsx src/generators/staleness-lint.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.118",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldpress-labs/coldpress-os.git"
  },
  "homepage": "https://github.com/coldpress-labs/coldpress-os",
  "bugs": {
    "url": "https://github.com/coldpress-labs/coldpress-os/issues"
  },
  "license": "MIT",
  "author": "ColdPress Labs <team@coldpressai.com>",
  "keywords": [
    "ai",
    "agents",
    "agent-framework",
    "claude-code",
    "claude",
    "lifecycle",
    "development-framework",
    "sdlc"
  ],
  "publishConfig": {
    "access": "public"
  }
}
