{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coldpressai.com/schemas/sacred-docs/architecture.json",
  "title": "Architecture sacred-doc frontmatter",
  "description": "Structural contract for `_context/sacred/architecture.md` frontmatter.",
  "type": "object",
  "properties": {
    "sacred": { "const": true },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "created": { "type": "string", "format": "date" },
    "last_modified": { "type": "string", "format": "date" },
    "governance": { "type": "string", "enum": ["requires-review", "locked", "draft"] },
    "workflowType": { "const": "architecture" },
    "stepsCompleted": { "type": "array", "items": { "type": "string" } },
    "inputDocuments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Should include the PRD path; Conftest enforces upstream-reference integrity."
    },
    "approvers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Named approvers for architectural changes. Conftest gates architecture.md mutations on at-least-one approver."
    },
    "adr_references": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ADR-\\d{4}$" }
    }
  },
  "required": ["sacred", "version", "governance", "workflowType"],
  "additionalProperties": true
}
