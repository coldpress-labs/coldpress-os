{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coldpressai.com/schemas/sacred-docs/tech-stack.json",
  "title": "Tech-stack sacred-doc frontmatter",
  "description": "Structural contract for `_context/sacred/tech-stack.md`.",
  "type": "object",
  "properties": {
    "sacred": { "const": true },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "created": { "type": "string", "format": "date" },
    "last_modified": { "type": "string", "format": "date" },
    "governance": { "type": "string", "enum": ["requires-review", "locked", "draft"] },
    "workflowType": { "const": "tech-stack" },
    "stepsCompleted": { "type": "array", "items": { "type": "string" } },
    "inputDocuments": { "type": "array", "items": { "type": "string" } },
    "stack_pack": {
      "type": "string",
      "description": "Stack-pack id this tech-stack descends from (e.g., `vibe-coder`, `nextjs-convex`). Optional."
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^_input/.*\\.(md|pdf|docx|txt)$" },
      "description": "_input/ paths whose conclusions this sacred doc supersedes."
    },
    "derived_from": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to Phase 2 + Phase 3 upstream artefacts (context.md, product-brief-v{N}, shortlist, ADRs)."
    }
  },
  "required": ["sacred", "version", "governance", "workflowType", "derived_from"],
  "additionalProperties": true
}
