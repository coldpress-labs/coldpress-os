{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coldpressai.com/schemas/audit/course-correction.json",
  "title": "Course Correction (Phase 10)",
  "description": "Phase 10 course-correction record. Validated-distillate. Authored by @devops (or @scrum-master for sprint-cadence corrections) when operational state diverges from plan and a mid-iteration adjustment is required. Surfaces ops-deltas as side-effect. Lives at `_context/audit/course-correction-v{N}.md`.",
  "type": "object",
  "required": ["schema", "phase", "version", "author_agent", "status", "created_at", "trigger", "diagnosis", "decision", "actions"],
  "properties": {
    "schema": { "const": "schemas/audit/course-correction.json" },
    "phase": { "const": 10 },
    "version": { "type": "integer", "minimum": 1 },
    "author_agent": { "type": "string", "enum": ["@devops", "@scrum-master", "@developer"] },
    "status": { "type": "string", "enum": ["draft", "validated", "superseded"] },
    "created_at": { "type": "string", "format": "date-time" },
    "trigger": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["incident", "slo-breach", "metric-anomaly", "sprint-slip", "scope-creep", "user-feedback", "dependency-failure", "security-finding", "cost-overrun"]
        },
        "description": { "type": "string", "minLength": 10 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": ["root_cause"],
      "properties": {
        "root_cause": { "type": "string" },
        "contributing_factors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope_impact": {
          "type": "string",
          "enum": ["story-level", "epic-level", "iteration-level", "system-level"]
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["action_class", "rationale"],
      "properties": {
        "action_class": {
          "type": "string",
          "enum": ["hotfix", "rollback", "feature-flag-disable", "scope-cut", "rescope", "extend-iteration", "escalate-to-architecture", "escalate-to-product"]
        },
        "rationale": { "type": "string" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "owner_agent"],
        "properties": {
          "description": { "type": "string" },
          "owner_agent": { "type": "string" },
          "target_completion": { "type": ["string", "null"], "format": "date" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" },
          "linked_story_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "surfaced_ops_deltas": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ops-delta-[0-9]{3,}$" },
      "description": "ops-delta IDs surfaced as a result of this correction."
    },
    "follow_up_required": { "type": "boolean", "default": false }
  }
}
