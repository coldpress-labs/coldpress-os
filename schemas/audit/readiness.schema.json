{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coldpressai.com/schemas/audit/readiness.json",
  "title": "Readiness Report (Phase 9)",
  "description": "Phase 9 readiness report. Validated-distillate, meta-aggregator. Authored by @devops via the readiness skill. Two variants: pre-deploy (aggregates env-check + dep-health-check + security-scan + db-migration-check) and post-deploy (aggregates smoke-test + observability-baseline). Block on any failed check.",
  "type": "object",
  "required": ["schema", "phase", "version", "variant", "author_agent", "status", "created_at", "checks", "overall_status"],
  "properties": {
    "schema": { "const": "schemas/audit/readiness.json" },
    "phase": { "const": 9 },
    "version": { "type": "integer", "minimum": 1 },
    "variant": {
      "type": "string",
      "enum": ["pre-deploy", "post-deploy"],
      "description": "pre-deploy = full aggregation (5 checks); post-deploy = smoke + observability (3 checks)."
    },
    "author_agent": { "const": "@devops" },
    "status": { "type": "string", "enum": ["draft", "validated", "superseded"] },
    "created_at": { "type": "string", "format": "date-time" },
    "deploy_target": {
      "type": ["object", "null"],
      "properties": {
        "environment": { "type": "string", "enum": ["dev", "staging", "production", "preview"] },
        "version_label": { "type": ["string", "null"] },
        "commit_sha": { "type": ["string", "null"] }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "kind", "status"],
        "properties": {
          "check_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["env-check", "dep-health-check", "security-scan", "db-migration-check", "smoke-test", "observability-baseline", "rollback-plan", "feature-flag-state"]
          },
          "status": { "type": "string", "enum": ["pass", "fail", "warn", "skip"] },
          "severity": { "type": "string", "enum": ["block", "warn", "info"] },
          "summary": { "type": "string" },
          "evidence_ref": { "type": ["string", "null"] },
          "remediation": { "type": ["string", "null"] }
        }
      }
    },
    "overall_status": { "type": "string", "enum": ["pass", "fail", "warn"] },
    "blocking_failures": { "type": "integer", "minimum": 0 },
    "rollback_plan_ref": { "type": ["string", "null"] }
  }
}
