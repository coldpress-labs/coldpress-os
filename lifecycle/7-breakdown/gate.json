      "severity": "block",
      "artefact_path": "_context/planning/epics.md",
      "remediation": "Run `@pm create-epics`"
    },
    {
      "id": "pert-chart-authored",
      "description": "Sacred document `_context/sacred/pert-chart.md` exists with wave assignments",
      "kind": "artefact-present",
      "severity": "block",
      "artefact_path": "_context/sacred/pert-chart.md",
      "remediation": "Run `@scrum-master parallelization-strategy`"
    },
    {
      "id": "pert-meta-sidecar",
      "description": "PERT → stories handoff sidecar validates against `schemas/handoffs/pert-to-stories.schema.ts`",
      "kind": "automated",
      "severity": "block",
      "skill_ref": "validate-handoff"
    },
    {
      "id": "stories-authored",
      "description": "Story files exist under `_context/implementation/` for every epic in the first wave",
      "kind": "artefact-present",
      "severity": "block",
      "artefact_path": "_context/implementation/",
      "remediation": "Run `@scrum-master create-stories`"
    },
    {
      "id": "sprint-status-initialised",
      "description": "`_context/tracking/sprint-status.yaml` exists with the current sprint's epic + story list",
