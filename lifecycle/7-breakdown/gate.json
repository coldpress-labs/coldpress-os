      "severity": "block",
      "artefact_path": "_context/tracking/sprint-status.yaml",
      "remediation": "Run `@scrum-master sprint-planning`"
    },
    {
      "id": "implementation-readiness-passed",
      "description": "`@qa implementation-readiness` gate reports READY",
      "kind": "automated",
      "severity": "block",
      "skill_ref": "implementation-readiness",
      "remediation": "Address gaps surfaced by implementation-readiness — typically acceptance-criteria detail, test-data plans, or rollback strategy"
    },
    {
      "id": "pert-sacred-signoff",
      "description": "User has accepted `_context/sacred/pert-chart.md` as the wave plan",
      "kind": "human",
      "severity": "block",
      "human_approver": "user"
    }
  ],
  "next_phase": "6-implementation"
